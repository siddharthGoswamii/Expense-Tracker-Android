<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:padding="28dp">

    <!-- Back button -->
    <Button
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="← Back"
        android:textColor="#888888"
        android:textSize="15sp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/back_btn_bg"/>

    <!-- Center content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="start">

        <!-- Lock icon box -->
        <TextView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_bg"
            android:gravity="center"
            android:text="🔒"
            android:textSize="22sp"
            android:layout_marginBottom="20dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot password?"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No worries! Enter your registered email and we will send you a one-time password."
            android:textColor="#666666"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="32dp"/>

        <!-- Email label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email address"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <!-- Email input -->
        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/edit_bg"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <!-- Helper text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We will send a 6-digit OTP to this email."
            android:textColor="#555555"
            android:textSize="12sp"
            android:layout_marginBottom="28dp"/>

        <!-- Send OTP button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/sendOtpBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_login_bg"
            android:text="Send OTP"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Back to login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remember your password? "
                android:textColor="#555555"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/loginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textColor="#2196F3"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>