<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:padding="28dp">

    <!-- Back button -->
    <TextView
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="← Back"
        android:textColor="#888888"
        android:textSize="15sp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/back_btn_bg"/>

    <!-- Center content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="start">

        <!-- Shield Lock icon -->
        <TextView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/icon_bg"
            android:gravity="center"
            android:text="🔐"
            android:textSize="22sp"
            android:layout_marginBottom="20dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset password"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your new password must be different from your previous password."
            android:textColor="#666666"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="32dp"/>

        <!-- New Password label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New password"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <!-- New Password field with show/hide icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/edit_bg"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/newPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Enter new password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <ImageView
                android:id="@+id/toggleNewPassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"
                android:src="@android:drawable/ic_menu_view"

                android:clickable="true"
                android:focusable="true"/>

        </RelativeLayout>

        <!-- New password hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Must be at least 8 characters."
            android:textColor="#555555"
            android:textSize="11sp"
            android:layout_marginBottom="20dp"/>

        <!-- Confirm Password label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm password"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="6dp"/>

        <!-- Confirm Password field with show/hide icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/edit_bg"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/confirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Re-enter your password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <ImageView
                android:id="@+id/toggleConfirmPassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"
                android:src="@android:drawable/ic_menu_view"

                android:clickable="true"
                android:focusable="true"/>

        </RelativeLayout>

        <!-- Confirm password hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Both passwords must match."
            android:textColor="#555555"
            android:textSize="11sp"
            android:layout_marginBottom="32dp"/>

        <!-- Reset Password button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/resetPasswordBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_login_bg"
            android:text="Reset Password"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Back to login -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remember your password? "
                android:textColor="#555555"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/loginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textColor="#2196F3"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>