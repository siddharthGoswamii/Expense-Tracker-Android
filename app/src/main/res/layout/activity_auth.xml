<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- App icon -->
    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/icon_bg"
        android:gravity="center"
        android:text="₹"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- App name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ExpenseTracker"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="48dp"
        android:text="Track your money, own your future"
        android:textColor="#888888"
        android:textSize="14sp" />

    <!-- Login button — blue to purple gradient -->
    <Button
        android:id="@+id/loginBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/btn_login_bg"
        android:backgroundTint="@null"
        android:text="Login"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp"/>

    <!-- Signup button — teal to green gradient -->
    <Button
        android:id="@+id/signupBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/signup_btn_bg"
        android:backgroundTint="@null"
        android:text="Create Account"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your data is private and secure"
        android:textColor="#555555"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal" />

</LinearLayout>

